{
  "manifest_version": 3,
  "name": "ConsentCart",
  "version": "0.1.0",
  "description": "Read the seller's terms as one label before you pay. Opens ConsentCart in a drawer on the checkout page.",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "ConsentCart", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "background": {"service_worker": "background.js"},
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
